node_modules
dist
.DS_Store
*.local
.vite

# Raw originals (logos, photos, PDFs, membership xlsx with PII) — never publish
_source/

# Local Claude Code settings + ephemeral state (per-machine)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Cached psychometrics survey downloads (~157 MB) — regenerated by build_norms.py
scripts/psychometrics/.cache/

# Environment files (Supabase URL/keys). Only the *.example templates are committed.
.env
.env.*
!.env.example
supabase/.env
supabase/.temp/
supabase/.branches/

# Duplicate skills cache written by `npx skills add` (canonical copy is .claude/skills/)
.agents/

# Vercel CLI project link (created by `vercel link`)
.vercel

# Page-walk output (scripts/page-walk.mjs): screenshots, and auth.json, a live portal session
.page-walk/
