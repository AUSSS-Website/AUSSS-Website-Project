# Security + caching headers. Read by Cloudflare Pages and Netlify (both serve
# this file from the publish root). Vercel uses the "headers" block in
# vercel.json instead (kept in sync there).

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://*.googleusercontent.com https://vitals.vercel-insights.com https://wjijkqrdaakiwbtdssio.supabase.co wss://wjijkqrdaakiwbtdssio.supabase.co; frame-src https://calendar.google.com https://www.canva.com https://drive.google.com https://*.googleusercontent.com; upgrade-insecure-requests

# Fingerprinted build assets never change for a given URL — cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
