# Secrets referenced as env(NAME) from supabase/config.toml.
# Copy to supabase/.env (gitignored). scripts/db/supa.mjs loads this file before
# running the CLI, so `npm run db:config-push` can resolve the placeholders.

# Google Cloud OAuth 2.0 Web client (create it signed in as aussswebsite@gmail.com).
# Authorised redirect URI: https://wjijkqrdaakiwbtdssio.supabase.co/auth/v1/callback
# The CLI rejects config.toml while these are empty (Google is enabled there), so every
# `npm run db:*` command needs SOME value. Only `config push` sends them to the project;
# for db push / link / list a placeholder like "local-placeholder" is fine.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Resend API key, used as the SMTP password once [auth.email.smtp] is enabled in
# config.toml. Only needed for magic-link email at scale; Google sign-in works
# without it.
RESEND_API_KEY=
